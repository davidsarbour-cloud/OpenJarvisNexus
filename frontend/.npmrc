# Nexus9 frontend — npm config
#
# React 19 + Vite + Tauri stack. Some deps (@arwes/react prerelease,
# @base-ui/react prerelease, a few @tauri-apps plugins) still declare
# `peerDependencies: react@"^17 || ^18"`. They work fine at runtime with
# React 19, the maintainers just haven't widened the peer range yet.
#
# legacy-peer-deps=true reproduces npm v6 behavior: peer deps are NOT
# auto-installed and conflicts are downgraded to warnings. Without this,
# every `npm install` fails with ERESOLVE on a fresh clone.
#
# When all transitive deps publish React 19 peer ranges, remove this file.
legacy-peer-deps=true
